{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "joker-roulette",
  "compatibility_date": "2026-08-02",
  "main": "src/worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/wl-track.js", "/arena/", "/battles/", "/blast/", "/bowling/", "/cannon/", "/carnival/", "/derby/", "/empire/", "/dice/", "/flowers/", "/hilo/", "/joker/", "/kahuna/", "/yungreal/", "/heist/", "/mansion/", "/mines/", "/pairs/", "/palace/", "/poker/", "/scraprig/", "/smash/", "/surf/", "/zombies/", "/arena/index.html", "/battles/index.html", "/blast/index.html", "/bowling/index.html", "/cannon/index.html", "/carnival/index.html", "/derby/index.html", "/empire/index.html", "/dice/index.html", "/flowers/index.html", "/hilo/index.html", "/joker/index.html", "/kahuna/index.html", "/yungreal/index.html", "/heist/index.html", "/mansion/index.html", "/mines/index.html", "/pairs/index.html", "/palace/index.html", "/poker/index.html", "/scraprig/index.html", "/smash/index.html", "/surf/index.html", "/zombies/index.html"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "bowling-stats", "database_id": "dc6a9f50-7085-408a-adf2-2edf29112921" }
  ],
  "observability": { "enabled": true }
}
